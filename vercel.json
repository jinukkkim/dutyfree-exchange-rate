{
  "buildCommand": "cd web && npm ci && npm run build",
  "outputDirectory": "web/dist",
  "installCommand": "echo skip",
  "framework": null,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "dutyfree-exchange-rate.vercel.app"
        }
      ],
      "destination": "https://dutyfreerate.com/$1",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/guide",
      "destination": "/guide.html"
    },
    {
      "source": "/en",
      "destination": "/en.html"
    },
    {
      "source": "/en/guide",
      "destination": "/en-guide.html"
    },
    {
      "source": "/ja",
      "destination": "/ja.html"
    },
    {
      "source": "/ja/guide",
      "destination": "/ja-guide.html"
    },
    {
      "source": "/zh-Hans",
      "destination": "/zh-Hans.html"
    },
    {
      "source": "/zh-Hans/guide",
      "destination": "/zh-Hans-guide.html"
    },
    {
      "source": "/zh-Hant",
      "destination": "/zh-Hant.html"
    },
    {
      "source": "/zh-Hant/guide",
      "destination": "/zh-Hant-guide.html"
    },
    {
      "source": "/zh-hans",
      "destination": "/zh-Hans.html"
    },
    {
      "source": "/zh-hans/guide",
      "destination": "/zh-Hans-guide.html"
    },
    {
      "source": "/zh-hant",
      "destination": "/zh-Hant.html"
    },
    {
      "source": "/zh-hant/guide",
      "destination": "/zh-Hant-guide.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
